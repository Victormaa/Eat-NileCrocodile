  - stepType: 0
    tipMessage: "\u592A\u68D2\u4E86!\u73B0\u5728\u5C3C\u7F57\u9CC4\u6709\u8DB3\u591F\u7684\u529B\u6C14\u6765\u63D0\u5347\u81EA\u5DF1\u7684\u80FD\u529B\u4E86!\u5148\u6765\u63D0\u5347\u4E00\u4E0B\u6293\u6355\u901F\u5EA6\u5427\r"
