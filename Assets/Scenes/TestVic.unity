  - stepType: 0
    tipMessage: "\u73B0\u5728\u6211\u4EEC\u53C8\u6709\u8DB3\u591F\u7684\u80FD\u529B\u6765\u628A\u5C3C\u7F57\u9CC4\u53D8\u5F97\u66F4\u806A\u660E\u4E00\u4E9B!
