  m_Name: 
  m_EditorClassIdentifier: 
  tipText: {fileID: 1234279361}
  rainHerdGoSequence: {fileID: 139006081}
  tipFadeInDuration: 0.25
  tipFadeOutDuration: 0.25
  tipFloatDistance: 30
  initiallyHidden:
  - {fileID: 160464816}
  - {fileID: 1293708734}
  - {fileID: 910001010}
  - {fileID: 910001005}
  - {fileID: 910001006}
  - {fileID: 910001007}
  - {fileID: 910001008}
  - {fileID: 910001009}
  playOnStart: 1
  steps:
  - stepType: 0
    tipMessage: "The wildebeests fear the crocodiles and refuse to enter the river.
      Try <link=swing>Summon Rain Clouds</link> to guide them across!\n(You\u2019ll
      need to summon rain clouds multiple times for them to appear!)"
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 3
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: Rain clouds make grass grow faster on land, luring wildebeests to
      run toward the lush grass on the opposite bank.
    tipDuration: 5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: "Seize this chance \u2014 let the Nile crocodiles feast on 5 wildebeests
      first!"
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 1
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 5
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: Wildebeests will dash away when spotting Nile crocodiles. Click them
      with your mouse to slow them down!
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 2
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 5
    objectsToShow: []
  - stepType: 4
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow:
    - {fileID: 910001005}
  - stepType: 0
    tipMessage: "Awesome! The Nile crocodile now has enough strength to upgrade its
      abilities. Let\u2019s boost its capture speed first!"
    tipDuration: 3
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: "Feed the crocs 18 wildebeests, and they\u2019ll be much happier!"
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 2
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 18
    objectsToShow: []
  - stepType: 4
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow:
    - {fileID: 910001010}
  - stepType: 0
    tipMessage: "We\u2019ve gained enough fullness to make the Nile crocodiles smarter!\nUnlock
      the crocs\u2019 hidden ability: lie in ambush, wait for wildebeests to draw
      near, then snap them up!"
    tipDuration: 15
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: "The Nile crocodiles are half full at last! But it\u2019s still not
      enough \u2014 they need to eat 35 wildebeests."
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 2
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 35
    objectsToShow: []
  - stepType: 4
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow:
    - {fileID: 910001007}
  - stepType: 0
    tipMessage: 'Now we can build a Crocodile Restaurant. Supply croc fat to the
      restaurant, and it will leave crocodile skins for us.

      Crocodile skins
      are incredibly valuable!'
    tipDuration: 5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 4
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow:
    - {fileID: 160464816}
  - stepType: 1
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 3
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: "Hurry to upgrade the Nile crocodiles\u2019 abilities so they can
      get full soon! Time is running out for the crocs!"
    tipDuration: 3
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: "Let\u2019s aim to feed them 66 wildebeests!"
    tipDuration: 3
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 2
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 66
    objectsToShow: []
  - stepType: 0
    tipMessage: 'Great news! World-famous Ermes will build a leather factory here!
      It will reward us with coins for the Nile crocodiles!

      Use coins to build
      fences, guiding more wildebeests straight toward the crocs!'
    tipDuration: 10
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
  - stepType: 4
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow:
    - {fileID: 1293708734}
    - {fileID: 910001008}
    - {fileID: 910001006}
  - stepType: 1
    tipMessage: 
    tipDuration: 2.5
    waitSeconds: 2
    requiredEaten: 1
    objectsToShow: []
  - stepType: 0
    tipMessage: "Perfect! The Nile crocodiles are almost full! Let\u2019s rush to
      max out all their abilities and raise an ultimate super crocodile!"
    tipDuration: 5
    waitSeconds: 1
    requiredEaten: 1
    objectsToShow: []
